<Project>
  <!--
    The version of everything built from here: cks, cks-gui and the library they share. Its first
    two numbers follow the game's major.minor - 1.3 for Core Keeper 1.3 - so the number says which
    game the tool is made for, and the third counts the tool's own releases for that game (1.3.1
    added the mod.io export). The mod inside keeps a version of its own (ModVersion in
    src/mod/CustomPlayerSkinMod.cs), which only the game's log shows.

    StartupGate.ApplicationVersion records this when the terms are accepted, but only whether
    anything was recorded decides if they are asked again (DisclaimerSettings.IsAccepted), so a new
    version does not ask anyone to accept them again.
  -->
  <PropertyGroup>
    <Version>1.3.1</Version>
  </PropertyGroup>
</Project>
