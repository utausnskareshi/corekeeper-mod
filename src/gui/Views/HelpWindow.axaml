<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:CoreKeeperSkinTool.Help"
        xmlns:loc="using:CoreKeeperSkinTool.Gui.Localization"
        x:Class="CoreKeeperSkinTool.Gui.Views.HelpWindow"
        Icon="/Assets/icon.ico"
        Width="860" Height="760"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,20,0,8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.paragraph">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style Selector="TextBlock.term">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.termDescription">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Padding="20,14" Background="#22000000">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
    </Border>

    <ScrollViewer Grid.Row="1" Padding="20,4,20,20" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="SectionList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="help:HelpSection">
            <StackPanel>
              <TextBlock Classes="heading" Text="{Binding Heading}" />

              <ItemsControl ItemsSource="{Binding Paragraphs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="paragraph" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!--
                Text meant to be copied out and used elsewhere, so it is shown exactly as
                written: fixed width, no wrapping, selectable, with a button that copies it.
              -->
              <Border IsVisible="{Binding HasPrompt}" Margin="0,4,0,10"
                      Background="#1E000000" CornerRadius="4" Padding="12,10">
                <StackPanel>
                  <Button Classes="copy" HorizontalAlignment="Right" Padding="12,4" Margin="0,0,0,6"
                          Content="{loc:Tr help.copyPrompt}"
                          CommandParameter="{Binding Prompt}" />
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="340">
                    <SelectableTextBlock Text="{Binding Prompt}" FontSize="12"
                                         FontFamily="Consolas,Menlo,monospace" />
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding Terms}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="help:HelpTerm">
                    <Border Background="#14000000" CornerRadius="4" Padding="12,9" Margin="0,0,0,6">
                      <StackPanel>
                        <TextBlock Classes="term" Text="{Binding Term}" />
                        <TextBlock Classes="termDescription" Text="{Binding Description}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="20,12" Background="#22000000">
      <Button x:Name="CloseButton" HorizontalAlignment="Right" Padding="20,6"
              Content="{loc:Tr help.close}" />
    </Border>

  </Grid>
</Window>
