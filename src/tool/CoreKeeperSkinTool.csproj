<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keep the executable name short: cks, for Core Keeper Skin -->
    <AssemblyName>cks</AssemblyName>
    <RootNamespace>CoreKeeperSkinTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Matches LICENSE, which ships beside this executable. See the GUI project for why the
       version is left alone. -->
  <PropertyGroup>
    <Product>Core Keeper スキン作成ツール</Product>
    <AssemblyTitle>Core Keeper スキン作成ツール (コマンドライン)</AssemblyTitle>
    <Authors>歌うＬＩＮＥ彼氏</Authors>
    <Company>歌うＬＩＮＥ彼氏</Company>
    <Copyright>Copyright (c) 2026 歌うＬＩＮＥ彼氏</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\CoreKeeperSkinTool.Core.csproj" />
  </ItemGroup>

</Project>
